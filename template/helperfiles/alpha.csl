<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="de-DE">
  <info>
    <title>DIN 1505-2 (alphanumeric, Deutsch)</title>
    <id>http://www.zotero.org/styles/din-1505-2-alphanumeric</id>
    <link href="http://www.zotero.org/styles/din-1505-2-alphanumeric" rel="self"/>
    <link href="http://www.zotero.org/styles/din-1505-2" rel="template"/>
    <link href="http://www.beuth.de/cmd?level=tpl-home&amp;websource=beuth&amp;smoid=112949" rel="documentation"/>
    <link href="http://www.sub.uni-hamburg.de/service/literaturverwaltung/endnote/stile.html" rel="documentation"/>
    <author>
      <name>Sven Rothe</name>
      <email>mmoole@googlemail.com</email>
    </author>
    <category citation-format="label"/>
    <category field="generic-base"/>
    <summary>Style following DIN 1505-2, for other media types on additional standards 
      Hinweise zur Benutzung: 
      * Zitieren von Gesetzen: 
        - hierfuer den Typ "Bill" (Gesetz) verwenden. 
        - Den Paragraphen in das Feld "Code" einfuegen. 
        - Das Datum in das Feld "Date" einfuegen. 
        - Die Bezeichnung des Gesetzblattes in das Feld "Journal" einfuegen.
        - Das Datum des Gesetzblattes in das Feld "Issue Date" einfuegen. 
        - Die Seite in das Feld "Pages" einfuegen. 
        - wird automatisch als "Zitierweise der amtlichen Begruendung" formatiert. 
      * Zitieren von Normen: 
        - hierfuer den Typ "Report" (Bericht) verwenden. 
        - Die Typbezeichnung (z.B. "DIN") in das Feld "Type" einfuegen. 
        - Die Nummer der Norm in das Feld "Report Number" einfuegen. 
        - Den Ausgabetag in das Feld "Date" einfuegen. 
        - Den Titel der Norm in das Feld "Title" einfuegen.</summary>
    <updated>2012-09-27T22:06:38+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de">
    <terms>
      <term name="anonymous" form="short">o.&#160;A.</term>
      <term name="no date" form="short">o.&#160;J.</term>
      <term name="collection-editor" form="short">Hrsg.</term>
      <term name="retrieved">abgerufen am</term>
      <term name="composer" form="short">Komp.</term>
      <term name="composer" form="long">Komponist</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author" delimiter=" ; ">
      <name name-as-sort-order="all" sort-separator=", " delimiter=" ; " delimiter-precedes-last="always" font-variant="small-caps"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="author-container">
    <names variable="container-author" delimiter=" ; ">
      <name name-as-sort-order="all" sort-separator=", " delimiter=" ; " delimiter-precedes-last="always" font-variant="small-caps"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor" delimiter=" ; ">
      <name name-as-sort-order="all" sort-separator=", " delimiter=" ; " delimiter-precedes-last="always" font-variant="small-caps"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="editor-collection">
    <names variable="collection-editor" delimiter=" ; ">
      <name name-as-sort-order="all" sort-separator=", " delimiter=" ; " delimiter-precedes-last="always" font-variant="small-caps"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="composer">
    <names variable="composer" delimiter=" ; ">
      <name name-as-sort-order="all" sort-separator=", " delimiter=" ; " delimiter-precedes-last="always" font-variant="small-caps"/>
      <label form="long" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="translator">
    <names variable="translator" delimiter=" ; ">
      <name name-as-sort-order="all" sort-separator=", " delimiter=" ; " delimiter-precedes-last="always" font-variant="small-caps"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="recipient">
    <names variable="recipient" delimiter=" ; ">
      <name name-as-sort-order="all" sort-separator=", " delimiter=" ; " delimiter-precedes-last="always" font-variant="small-caps"/>
    </names>
  </macro>
  <macro name="access">
    <group>
      <text term="retrieved" suffix=" "/>
      <date variable="accessed">
        <date-part name="year" form="long" suffix="-"/>
        <date-part name="month" form="numeric-leading-zeros" suffix="-"/>
        <date-part name="day" form="numeric-leading-zeros"/>
      </date>
    </group>
  </macro>
  <macro name="title">
    <choose>
      <if type="bill" match="any">
        <group delimiter=" - ">
          <text variable="title-short" font-weight="normal"/>
          <text variable="title"/>
        </group>
      </if>
      <else-if type="book" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else-if type="graphic" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else-if type="motion_picture" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else-if type="report" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else-if type="song" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>
  <macro name="genre">
    <choose>
      <if type="report" match="any">
        <group delimiter=" ; ">
          <text variable="genre"/>
          <text variable="number"/>
        </group>
      </if>
      <else>
        <text variable="genre"/>
      </else>
    </choose>
  </macro>
  <macro name="volumes">
    <group delimiter=" ">
      <text term="volume" form="short" plural="false"/>
      <number variable="volume" form="numeric"/>
      <number variable="number-of-volumes" form="numeric" prefix="v. "/>
    </group>
  </macro>
  <macro name="edition">
    <group>
      <number variable="edition" form="numeric" suffix=". "/>
      <text term="edition" form="short" plural="false"/>
    </group>
  </macro>
  <macro name="pages">
    <choose>
      <if type="chapter" match="any">
        <label variable="page" form="short" suffix=" "/>
        <text variable="page"/>
      </if>
      <else-if type="article-journal" match="any">
        <text variable="page"/>
      </else-if>
      <else-if type="article-magazine" match="any">
        <text variable="page"/>
      </else-if>
      <else-if type="article-newspaper" match="any">
        <text variable="page"/>
      </else-if>
      <else>
        <group delimiter=" ">
          <text variable="page"/>
          <text term="page" form="short" plural="true"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="dimensions">
    <group>
      <text variable="dimensions"/>
    </group>
  </macro>
  <macro name="medium">
    <group>
      <text variable="medium"/>
    </group>
  </macro>
  <macro name="scale">
    <group>
      <text variable="scale"/>
    </group>
  </macro>
  <macro name="recipient-show">
    <choose>
      <if type="personal_communication" match="any">
        <choose>
          <if variable="genre">
            <text variable="genre" text-case="capitalize-first"/>
          </if>
          <else>
            <text term="letter" text-case="capitalize-first"/>
          </else>
        </choose>
      </if>
    </choose>
    <text macro="recipient" prefix=", "/>
  </macro>
  <macro name="cite-year">
    <group>
      <date variable="issued">
        <date-part name="year"/>
      </date>
      <text variable="year-suffix"/>
    </group>
  </macro>
  <macro name="label-citation">
    <names variable="author">
      <name form="short" delimiter="/" delimiter-precedes-last="never" initialize-with="" name-as-sort-order="all"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text term="anonymous" form="short"/>
      </substitute>
    </names>
    <text macro="cite-year"/>
  </macro>
  <citation collapse="year">
    <sort>
      <key variable="citation-label"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter="; ">
      <group delimiter=", ">
        <text macro="label-citation"/>
        <group>
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>
  <bibliography et-al-min="9" et-al-use-first="8">
    <sort>
      <key macro="label-citation"/>
      <key variable="issued" sort="descending"/>
    </sort>
    <layout>
      <group delimiter=" " prefix="[" suffix="] ">
        <text macro="label-citation"/>
      </group>
      <group delimiter=" ; " suffix=".">
        <group delimiter=" ">
          <text macro="author"/>
          <text macro="editor"/>
          <text macro="editor-collection"/>
          <text macro="composer"/>
        </group>
        <group delimiter=" ">
          <text macro="title"/>
          <text macro="genre"/>
          <text macro="medium"/>
        </group>
        <group delimiter=", ">
          <text macro="edition"/>
          <text macro="volumes"/>
          <group delimiter=" ">
            <text term="in" text-case="lowercase"/>
            <text macro="author-container"/>
            <text variable="container-title" font-style="italic"/>
          </group>
          <text macro="translator"/>
          <text variable="publisher-place"/>
          <text variable="publisher"/>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </group>
        <text macro="recipient-show"/>
        <text macro="pages"/>
        <text macro="access"/>
        <text variable="DOI" prefix="DOI "/>
        <text variable="URL"/>
      </group>
    </layout>
  </bibliography>
</style>